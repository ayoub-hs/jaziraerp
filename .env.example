# Al Jazira ERP — Environment Configuration Example
# Copy this file to .env to configure your local or private environment settings.
# Note: The .env file is git-ignored and will not be pushed to GitHub.

# Tailscale or remote server URL used on the mobile native app (Capacitor)
VITE_DEFAULT_SERVER_URL=https://votre-serveur.ts.net

# Optional comma-separated CORS allowed origins for the backend server
# ALLOWED_ORIGINS=https://votre-serveur.ts.net
